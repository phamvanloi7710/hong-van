APP_NAME=HongVan
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://hongvan.local
SEARCH_ANALYTICS_ENABLED=false
SEARCH_ANALYTICS_HASH_KEY=
PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=30

APP_TIMEZONE=UTC
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
APP_FAKER_LOCALE=vi_VN
API_DEFAULT_LOCALE=vi
ADMIN_DEFAULT_LOCALE=vi
API_RATE_LIMIT_PER_MINUTE=60
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_PASSWORD_RATE_LIMIT_PER_MINUTE=3
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
PREVIEW_SESSION_RATE_LIMIT_PER_MINUTE=10
PREVIEW_VIEW_RATE_LIMIT_PER_MINUTE=60
TRUSTED_HOSTS=hongvan.local,localhost,127.0.0.1
TRUSTED_PROXIES=
SECURITY_HSTS_MAX_AGE=31536000
AUDIT_RETENTION_DAYS=365
SECURITY_LOG_CHANNEL=security
SECURITY_LOG_LEVEL=notice
SECURITY_LOG_RETENTION_DAYS=90
MEDIA_DISK=public
MEDIA_VISIBILITY=public
MEDIA_QUEUE=media
MEDIA_MAX_UPLOAD_KB=10240
MEDIA_TRASH_RETENTION_DAYS=30
PAGE_BUILDER_PREVIEW_CACHE_STORE=redis
PAGE_BUILDER_PREVIEW_TTL_SECONDS=300
LEAD_DEDUPLICATE_MINUTES=15
LEAD_RETENTION_DAYS=365
LEAD_EXPORT_LIMIT=5000
LEAD_PRIVACY_POLICY_VERSION=2026-08
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_SYNC_EXPORT_LIMIT=1000
DASHBOARD_REPORT_RETENTION_HOURS=24
DASHBOARD_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hongvan_platform
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_ENGINE=InnoDB
DB_TIMEZONE=+00:00
AUTH_PASSWORD_RESET_TOKEN_TABLE=hongvan_password_reset_tokens

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=hongvan_sessions
SESSION_COOKIE=hongvan_admin_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=hongvan.local,localhost,localhost:4200,127.0.0.1,127.0.0.1:8000

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
DB_QUEUE_TABLE=hongvan_jobs
DB_QUEUE_BATCH_TABLE=hongvan_job_batches
DB_FAILED_JOBS_TABLE=hongvan_failed_jobs

CACHE_STORE=redis
CACHE_LIMITER_STORE=redis
DB_CACHE_TABLE=hongvan_cache
DB_CACHE_LOCK_TABLE=hongvan_cache_locks
CACHE_PREFIX=hongvan_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
